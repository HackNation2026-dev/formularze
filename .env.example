# copy to .env ; secrets only here, never in the image (R-15)
APP_PORT=8000
LOG_LEVEL=INFO

# upload limits (R-07)
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,doc,docx,ods,xlsx,jpg,jpeg,png

# auth (R-16). Generate a token: python scripts/make_token.py
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ALGORITHM=HS256
# JWT_ISSUER=coi
# JWT_AUDIENCE=formgen

# integrations (compose overrides the URLs)
LLM_BASE_URL=http://localhost:8080
LLM_MODEL=qwen3.5-4b
# open model hosted in the cloud (allowed when the model is open and self-hostable); local llama.cpp stays as backup
# LLM_BASE_URL=https://api.example.com
# LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# LLM_FALLBACK_BASE_URL=http://localhost:8080
# LLM_FALLBACK_MODEL=qwen3.5-4b
LLM_TIMEOUT_SECONDS=600
# context of one llama.cpp slot (-c divided by -np); prompt + answer of a chunk call must fit
LLM_CONTEXT_TOKENS=8192
OCR_BACKEND=tesseract
# DOC_CONVERTER_URL=http://localhost:9998

# pipeline features (optional extensions I, III, V)
WITH_VALIDATORS=true
WITH_DICTIONARIES=true
WITH_DEPENDENCIES=true
